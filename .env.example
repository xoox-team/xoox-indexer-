# Variable names the indexer image and the operations tooling read. Every value below is a placeholder: copy this file to
# a private, owner-only file (mode 0600), fill it in there and pass it with `docker run --env-file`. Never commit real values.

# --- required by the launch guard (scripts/launch-guard-lib.ts) ---
# Absolute path of the frozen config; the image keeps it at /workspace/config.xoox-one.json.
ENVIO_CONFIG=/workspace/config.xoox-one.json
# Must match ^xoox_one_[0-9a-z_]+$ and the schema must be xoox.
ENVIO_PG_DATABASE=xoox_one_<yyyymmdd>
ENVIO_PG_SCHEMA=xoox
# The host must be the Hasura service name the guard expects (XOOX_ONE_HASURA_HOST), path /v1/metadata, no credentials.
HASURA_GRAPHQL_ENDPOINT=http://<xoox-one hasura service>:8080/v1/metadata
HASURA_GRAPHQL_ADMIN_SECRET=<new hasura admin secret>
# Must equal rpc[0].url of the frozen config (the public archive node).
INDEXER_CONTRACT_RPC_URL=https://testnet-rpc.monad.xyz
# Base URLs of every old Hasura that must reject the new admin secret, separated by spaces or commas.
XOOX_ONE_LIVE_HASURA_ENDPOINTS=<old hasura base url> <old hasura base url>

# --- PostgreSQL connection read by Envio ---
ENVIO_PG_HOST=<postgres host>
ENVIO_PG_PORT=5432
ENVIO_PG_USER=<postgres role>
ENVIO_PG_PASSWORD=<postgres password>

# --- HyperSync history (not needed with the break-glass config) ---
ENVIO_API_TOKEN=<envio api token>

# --- operations tooling, set only for the command that needs them ---
# type-parity.ts
# PARITY_SOURCE_GRAPHQL_URL=<old hasura /v1/graphql url>
# PARITY_SOURCE_ADMIN_SECRET=<old hasura admin secret>
# PARITY_TARGET_GRAPHQL_URL=<new hasura /v1/graphql url>
# PARITY_TARGET_ADMIN_SECRET=<new hasura admin secret>
# effect-cache-export.ts (libpq variables)
# PGHOST=<postgres host>
# PGPORT=5432
# PGUSER=<postgres role>
# PGPASSWORD=<postgres password>
# backfill-estimator.ts
# ENVIO_HYPERSYNC_URL=<https origin of the hypersync endpoint for chain 10143, no path>
